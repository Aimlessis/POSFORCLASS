<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DolcePOSDummies"
        x:Class="DolcePOSDummies.ReportWindow"
        x:DataType="local:ReportWindow"
        Title="Reporte"
        Width="650" Height="440"
        MinWidth="500" MinHeight="350"
        >

    <DockPanel Margin="15">
        <TextBlock x:Name="ReportTitle" Text="REPORTE DE VENTAS" FontSize="18" FontWeight="Bold"
                   DockPanel.Dock="Top" HorizontalAlignment="Center" />

        <ComboBox x:Name="PeriodoCombo" DockPanel.Dock="Top" Width="180"
                  ItemsSource="{Binding Periodos}"
                  SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                  FontSize="11" Margin="0,10,0,0" />

        <DatePicker x:Name="FechaPicker" DockPanel.Dock="Top" Width="150"
                    SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                    Height="28" Margin="0,10,0,10" />

        <Button Content="Generar" Click="GenerarReporte_Click"
                DockPanel.Dock="Top" Padding="10,4" Width="100" Margin="0,10,0,5" />

        <TextBlock x:Name="StatusText" DockPanel.Dock="Top"
                   Foreground="Red" FontSize="12" Margin="0,0,0,5"
                   TextWrapping="Wrap" IsVisible="False" />

        <DataGrid x:Name="ReportGrid"
                  ItemsSource="{Binding ReportLines}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="Gray"
                  Padding="10"
                  DockPanel.Dock="Top"
                  VerticalAlignment="Top"
                  Height="220">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130" />
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="180" />
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="70" />
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat={}{0:C}}" Width="100" />
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C}}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Guardar Reporte" Click="GuardarReporte_Click" Padding="12,4" Width="140"/>
            <Button Content="Cerrar" Click="CloseReport_Click" Padding="12,4" Width="70"/>
        </StackPanel>
    </DockPanel>
</Window>