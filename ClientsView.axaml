<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DolcePOSDummies"
             x:Class="DolcePOSDummies.ClientsView">

    <DockPanel Margin="15">

        <!-- Form -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0" Spacing="10">
            <WrapPanel>
                <TextBox x:Name="NombreBox" Watermark="Nombre" Width="200" Margin="0,0,10,10"/>
                <TextBox x:Name="TelefonoBox" Watermark="Telefono" Width="150" Margin="0,0,10,10"/>
                <TextBox x:Name="DireccionBox" Watermark="Direccion" Width="220" Margin="0,0,10,10"/>
                <TextBox x:Name="CreditoBox" Watermark="Credito" Width="100" Margin="0,0,10,10"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Add" Click="Add_Click"/>
                <Button Content="Update selected" Click="Update_Click"/>
                <Button Content="Delete selected" Click="Delete_Click"/>
                <Button Content="Clear form" Click="ClearForm_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Grid -->
        <DataGrid x:Name="Grid"
                  x:DataType="local:Cliente"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="Gray"
                  SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="150"/>
                <DataGridTextColumn Header="Direccion" Binding="{Binding Direccion}" Width="220"/>
                <DataGridTextColumn Header="Credito" Binding="{Binding Credito, StringFormat={}{0:C}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>

</UserControl>
