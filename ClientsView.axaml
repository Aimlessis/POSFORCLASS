<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DolcePOSDummies"
             x:Class="DolcePOSDummies.ClientsView">

    <DockPanel Margin="15">

        <!-- Barra de búsqueda -->
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,15">
            <TextBox x:Name="BuscarBox" Watermark="Buscar cliente..." Width="300" TextChanged="BuscarBox_TextChanged"/>
        </StackPanel>


        <!-- Form -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0" Spacing="10">
            <WrapPanel>
                <TextBox x:Name="NombreBox" Watermark="Nombre" Width="200" Margin="0,0,10,10"/>
                <TextBox x:Name="TelefonoBox" Watermark="Telefono" Width="150" Margin="0,0,10,10"/>
                <TextBox x:Name="DireccionBox" Watermark="Direccion" Width="220" Margin="0,0,10,10"/>
                <TextBox x:Name="CreditoBox" Watermark="Credito" Width="100" Margin="0,0,10,10"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Agregar" Click="Add_Click"/>
                <Button Content="Actualizar seleccionado" Click="Update_Click"/>
                <Button Content="Eliminar seleccionado" Click="Delete_Click"/>
                <Button Content="Limpiar Formulario" Click="ClearForm_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Grid -->
        <DataGrid x:Name="Grid"
                  x:DataType="local:Cliente"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="Gray"
                  SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="150"/>
                <DataGridTextColumn Header="Direccion" Binding="{Binding Direccion}" Width="220"/>
                <DataGridTextColumn Header="Credito" Binding="{Binding Credito, StringFormat={}{0:C}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>

</UserControl>
