<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DolcePOSDummies"
             x:Class="DolcePOSDummies.ProductsView">

    <DockPanel Margin="15">

        <!-- Barra de busqueda -->
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,15">
            <TextBox x:Name="BuscarProducto" Watermark="Buscar producto..." Width="300" TextChanged="BuscarProducto_TextChanged"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0" Spacing="10">
            <WrapPanel>
                <TextBox x:Name="NombreBox" Watermark="Nombre" Width="200" Margin="0,0,10,10"/>
                <TextBox x:Name="CostoBox" Watermark="Costo" Width="100" Margin="0,0,10,10"/>
                <TextBox x:Name="PrecioBox" Watermark="Precio" Width="100" Margin="0,0,10,10"/>
                <TextBox x:Name="CantidadBox" Watermark="Cantidad" Width="100" Margin="0,0,10,10"/>
                <TextBox x:Name="DescuentoMaxBox" Watermark="Descuento max" Width="120" Margin="0,0,10,10"/>
                <TextBox x:Name="BeneficioBox" Watermark="Beneficio" Width="100" Margin="0,0,10,10"/>
                <TextBox x:Name="CategoriaBox" Watermark="Categoria" Width="140" Margin="0,0,10,10"/>
            </WrapPanel>
            <TextBox x:Name="DescripcionBox" Watermark="Descripcion" AcceptsReturn="True" Height="60"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Agregar" Click="Add_Click"/>
                <Button Content="Actualizar seleccionado" Click="Update_Click"/>
                <Button Content="Eliminar seleccionado" Click="Delete_Click"/>
                <Button Content="Limpiar Formulario" Click="ClearForm_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Grid -->
        <DataGrid x:Name="Grid"
                  x:DataType="local:Producto"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="Gray"
                  SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding NombreProducto}" Width="*"/>
                <DataGridTextColumn Header="Costo" Binding="{Binding Costo, StringFormat={}{0:C}}" Width="90"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat={}{0:C}}" Width="90"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadProducto}" Width="90"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>

</UserControl>
