<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DolcePOSDummies"
             x:Class="DolcePOSDummies.SalesView">

    <DockPanel Margin="15">

        <!-- Header row -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
            <ComboBox x:Name="ProductCombo" Width="260" PlaceholderText="Select a product"/>
            <TextBox x:Name="QuantityBox" Watermark="Qty" Width="80" Text="1"/>
            <Button Content="Add" Click="AddItem_Click" Padding="10,8" Margin="0,0,5,0"/>
            <Button Content="Remove selected" Click="RemoveItem_Click" Padding="10,8" Margin="0,0,5,0"/>
            <Button Content="Clear" Click="ClearItems_Click" Padding="10,8" Margin="0,0,5,0"/>
            <Button Content="Reportes" Click="ShowReports_Click" Padding="10,8" Margin="0,0,5,0"/>
        </StackPanel>

        <!-- Total + checkout row -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="15"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock x:Name="TotalText" Text="Total: $0.00" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Content="Checkout" Click="Checkout_Click" Padding="20,8"/>
        </StackPanel>

        <!-- Cart grid — fills remaining space -->
        <DataGrid x:Name="SalesGrid"
                  x:DataType="local:SaleLine"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="Gray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat={}{0:C}}" Width="120"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Cantidad}" Width="80"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>